    { "key": "bak.restore", "target": { "css": ".x-btn", "text": { "en": "Restore" } }, "side": "bottom" },
    { "key": "bak.protect", "target": { "css": ".x-btn", "text": { "en": "Change Protection" } }, "side": "bottom" }
  ]
}
